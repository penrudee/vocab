<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name='viewport' content='width=device-width, initial-scal3=1.0'/>
		<link rel="stylesheet" href="https://cdn.datatables.net/v/dt/dt-3.1.4/datatables.min.css">
		<script src="https://cdn.datatables.net/v/dt/dt-3.1.4/datatables.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
		<title>English Vocab</title>
	</head>
	<body>
		<div id='main' class='container m-4 mx-auto px-4'>
		<h1 class='text-3xl font-bold'>Vocab List</h1>
		<table id="vocabsTable">
		</table>
		
		<script defer>
			new DataTable('#vocabsTable',{
				columnDefs:[
					

				],
				pageLength:25,
			});
			
		</script>
		<script>
			var url = "https://penrudee.github.io/vocab/vocab1.csv"
			fetch(url).then((response) => response.text())
				.then((data)=>{
				const array = data.split('\n').map((row)=>row.split(',');
					console.log(array);
				});
			var vocabs = [
				"Cat",
				"Dog",
				"Bat"
			];
			var rows = ''
			vocabs.forEach(function(vocab){
				rows += `<tr>
						<td>
						<span class="vocab-word">${vocab}: </span>
						<button onclick ="speakWord('${vocab}')">🔊</button>
						</td>
					</tr>
					

				`;

			});
			document.getElementById("vocabsTable").innerHTML = rows;
			function speakWord(word){
				if('speechSynthesis' in window){

					window.speechSynthesis.cancel();
					//create text to speech
					const utterace = new SpeechSynthesisUtterance(word);
					//config speech to eng
					utterace.lang = 'en-US';
					//config speech rate
					utterace.rate=1.0;  //0.1-10
					utterace.pitch=1.0; // 0-2

					//start speech
					window.speechSynthesis.speak(utterace);
				}else{
					alert('เบราเซอร์ของคุณไม่รองรับการสังเคราะห์เสียงพูด');
				}

			};
		</script>
		</div>
	</body>
</html>
